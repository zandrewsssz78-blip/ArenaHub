# ==============================================================================
# ArenaHub — Plantilla de Variables de Entorno (Regla 3: Protección de Secretos)
# ==============================================================================
# NUNCA guarde credenciales reales ni contraseñas de producción en este archivo.
# Para desarrollo local, cree una copia de este archivo nombrada ".env" y defina
# allí sus credenciales locales. El archivo ".env" está ignorado en Git.

# Conexión a Base de Datos PostgreSQL
ARENAHUB_DB_URL=jdbc:postgresql://localhost:5432/reservas_deportivas?currentSchema=arenahub
ARENAHUB_DB_USER=arenahub
ARENAHUB_DB_PASSWORD=arenahub123

# Puerto del Servidor
PORT=8080
